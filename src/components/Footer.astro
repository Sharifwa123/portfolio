---
import { SITE } from '../data/site';
---
<footer class="foot">
  <div class="wrap foot__in">
    <span>{SITE.name} · <a href={SITE.company.url} rel="noopener">{SITE.company.name}</a> · {SITE.location}</span>
    <span><a href={SITE.github} rel="noopener">GitHub</a> · <a href={`mailto:${SITE.email}`}>{SITE.email}</a></span>
  </div>
</footer>
