---
import AdminBase from '../../layouts/AdminBase.astro';
import { adminConfigured } from '../../server/env';
import { audit, clientHash, hit, mintSession, passwordOk, sameOrigin, sessionCookie, isAuthed } from '../../server/auth';

export const prerender = false;
const configured = adminConfigured();
let error = '';
const secure = Astro.url.protocol === 'https:';

if (configured && isAuthed(Astro.request)) return Astro.redirect('/admin');

if (Astro.request.method === 'POST' && configured) {
  const who = clientHash(Astro.request, 'login');
  if (!sameOrigin(Astro.request)) {
    error = 'Request blocked.';
  } else if ((await hit(`rl:login:${who}`, 900)) > 8) {
    error = 'Too many attempts. Try again in 15 minutes.';
    await audit('login.throttled', who);
  } else {
    const form = await Astro.request.formData();
    if (passwordOk(String(form.get('password') ?? ''))) {
      await audit('login.ok', who);
      return new Response(null, { status: 303, headers: { Location: '/admin', 'Set-Cookie': sessionCookie(mintSession(), secure) } });
    }
    await audit('login.failed', who);
    error = 'Incorrect password.';
  }
}
---
<AdminBase title="Sign in" nav={false}>
  <div class="login">
    <p class="label">Admin</p>
    <h1 style="margin-block: var(--s-2) var(--s-6)">Sign in</h1>
    {!configured && (
      <div class="warn">
        <strong>Admin is not set up.</strong> Add two environment variables in Vercel (Settings → Environment Variables) and redeploy:
        <p class="mono" style="margin-top: var(--s-2); font-size: var(--t-xs)">ADMIN_PASSWORD (12+ characters)<br />SESSION_SECRET (32+ random characters)</p>
      </div>
    )}
    {error && <div class="err" role="alert">{error}</div>}
    <form method="post" autocomplete="off">
      <div class="field">
        <label class="label" for="pw">Password</label>
        <input id="pw" name="password" type="password" required autocomplete="current-password" disabled={!configured} />
      </div>
      <button class="btn btn--primary" type="submit" disabled={!configured}>Sign in</button>
    </form>
  </div>
</AdminBase>
